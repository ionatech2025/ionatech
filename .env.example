# ---------------------------------------------------------------------------
# iONA TECH — example environment file. Copy to .env.local and fill in.
#   cp .env.example .env.local
# Never commit .env.local. Vercel-managed values can be pulled with:
#   vercel env pull .env.local
# ---------------------------------------------------------------------------

# --- Public site (always required) ----------------------------------------

# Web3forms access key. Used by the contact form. Web3forms keys are public
# by design (they ship to the browser) but keeping it in env makes rotation
# easier than editing source.
VITE_WEB3FORMS_ACCESS_KEY=

# Public site origin — used in canonical/OG tags and sitemap.xml.
VITE_SITE_URL=https://ionatec.com

# --- Backend / admin (only required on the feat/admin-content-management
#     branch, when /api/* and the admin panel are deployed) ----------------

# Neon Postgres connection string. Auto-injected when the Neon Marketplace
# integration is installed on the Vercel project. Pull with `vercel env pull`.
DATABASE_URL=

# 32+ random bytes used to sign admin session JWTs.
#   openssl rand -hex 32
JWT_SECRET=

# Vercel Blob token. Auto-injected when the Blob Marketplace integration is
# installed. Used by /api/admin/upload for image uploads.
BLOB_READ_WRITE_TOKEN=

# One-time bootstrap. Set these, run `node db/seed.mjs`, then REMOVE them
# from the Vercel project settings — they are only consulted on first run.
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=
